# ── 大模型 ──────────────────────────────────────────
# 必填：Anthropic API Key
ANTHROPIC_API_KEY=your_api_key_here

# 可选：使用兼容 Anthropic 协议的第三方模型服务（如 DeepSeek）时配置
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── Redis（工作记忆）────────────────────────────────
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0

# ── ChromaDB（RAG 知识库 + 情景记忆 + 用户画像）────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 应用配置 ─────────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Skills ───────────────────────────────────────────
OPENMED_SKILLS_DIR=./skills
OPENMED_SKILLS_MAX_PROMPT_CHARS=5000

# ── 评测 ─────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── 监控 ─────────────────────────────────────────────
MONITOR_INTERVAL=10
PROMETHEUS_PORT=9090

# ── 轨迹采集（v2 阶段 0.1）──────────────────────────
# 落盘目录（默认 data/trajectories，已进 .gitignore）；0/false/off 可关闭
OPENMED_TRAJECTORY_DIR=./data/trajectories
OPENMED_TRAJECTORY_LOGGING=1

# ── 评测模式（v2 阶段 0.2）──────────────────────────
# 1/true/on/yes 开启：禁用工具缓存（每次搜索真实检索+精排），轨迹忠实记录检索行为。
# 注意：开启后检索延迟显著变高，只在跑评测/采集数据时开，线上保持 0
OPENMED_EVAL_MODE=0

# ── LLM 协议切换（v2 阶段 0.5）────────────────────────
# anthropic（默认）: 走 ANTHROPIC_BASE_URL（DeepSeek 兼容层），现有链路零变化
# openai: 走 OPENAI_BASE_URL / OPENAI_API_KEY（vLLM 自训练模型，阶段 4/7 评测用）
OPENMED_LLM_PROTOCOL=anthropic
# OPENAI_BASE_URL=http://<autodl-ip>:8000/v1
# OPENAI_API_KEY=EMPTY

# ── 急诊场景升级通知（可选）─────────────────────────
# OPENMED_EMERGENCY_WEBHOOK_URL=https://your-webhook-url