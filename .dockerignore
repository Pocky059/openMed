# 构建上下文排除清单
# 作用：缩小编译上下文（打包+传输变快）、防止宿主机的开发产物混进镜像
# （镜像里通过 pip 安装自己的依赖，宿主机 .venv 对容器无用）

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 宿主机虚拟环境（uv 建的 .venv，容器内不适用）
.venv/

# Git
.git/
.gitignore
.dockerignore

# 运行时数据（compose 里全部是卷挂载，运行时才写入，不该打进镜像）：
#   data/chroma      → ChromaDB 向量库（挂载 ./data/chroma）
#   data/eval        → 评测集（挂载 ./data/eval）
#   data/huggingface → HF 模型缓存（挂载 ./data/huggingface）
#   data/trajectories→ v2 轨迹日志（挂载 ./data/trajectories）
# 注意：data/demo_docs 是 RAG 知识库，需要打进镜像，不要排除！
data/chroma/
data/eval/
data/huggingface/
data/trajectories/

# 日志与文档（宿主机产物，镜像不需要）
logs/
docs/

# Docker 自身文件
docker-compose*.yml
